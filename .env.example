# Preencha este arquivo e salve como .env na raiz do projeto (não commite o .env real)
# Ele será usado pelo ./app.sh --all para não te perguntar nada durante a execução.

# 07-gitAndSSH.sh: identidade do Git (e comentário da chave SSH)
GIT_USERNAME="Seu Nome Aqui"
GIT_EMAIL="seu_email@aqui.com"

# 01-setupEnv.sh: usuário do GitHub dono dos forks pessoais (hidetopbar, lockkeys, grub2-theme).
# Vazio = pula a clonagem.
GITHUB_USER=""

# 10-themesAndGrub.sh: argumentos do install.sh do tema GRUB. Vazio = não instala tema.
# No Fedora use -b (instala em /boot/grub2, que fica numa partição separada).
# Exemplo: GRUB_THEME_ARGS="-b -t tela -s 1080p"
GRUB_THEME_ARGS=""
